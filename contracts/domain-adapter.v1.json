{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mce4d:domain-adapter:1",
  "$ref": "#/$defs/Batch",
  "$defs": {
    "Key": {"type":"object","properties":{"service_id":{"anyOf":[{"$ref":"urn:mce4d:contracts:1#/$defs/ID"},{"type":"null"}]},"environment":{"type":"string","minLength":1,"maxLength":128},"protocol":{"enum":["frontend","http","json_schema","protobuf","mysql","asyncapi","event","cache","state"]},"namespace":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,192}$"},"identifier":{"type":"string","minLength":1,"maxLength":1024},"version":{"type":"string","minLength":1,"maxLength":128}},"required":["service_id","environment","protocol","namespace","identifier","version"],"additionalProperties":false},
    "Entity": {"type":"object","properties":{"ref":{"$ref":"urn:mce4d:contracts:1#/$defs/EntityRef"},"kind":{"$ref":"urn:mce4d:contracts:1#/$defs/ID"},"key":{"$ref":"#/$defs/Key"},"plane":{"enum":["intended","observed_static"]},"declaration":{"$ref":"urn:mce4d:contracts:1#/$defs/SourceRef"}},"required":["ref","kind","key","plane","declaration"],"additionalProperties":false},
    "Field": {"type":"object","properties":{"entity":{"$ref":"urn:mce4d:contracts:1#/$defs/EntityRef"},"field_path":{"type":"string","minLength":1,"maxLength":1024},"direction":{"enum":["input","output","bidirectional","stored"]},"type":{"type":"string","minLength":1,"maxLength":128},"nullable":{"anyOf":[{"type":"boolean"},{"type":"null"}]},"unit":{"anyOf":[{"type":"string","minLength":1,"maxLength":64},{"type":"null"}]},"currency":{"anyOf":[{"type":"string","pattern":"^[A-Z]{3}$"},{"type":"null"}]},"precision":{"anyOf":[{"$ref":"urn:mce4d:contracts:1#/$defs/Count"},{"type":"null"}]},"declaration":{"$ref":"urn:mce4d:contracts:1#/$defs/SourceRef"}},"required":["entity","field_path","direction","type","nullable","unit","currency","precision","declaration"],"additionalProperties":false},
    "Endpoint": {"oneOf":[{"$ref":"urn:mce4d:contracts:1#/$defs/SymbolRef"},{"$ref":"urn:mce4d:contracts:1#/$defs/EntityRef"}]},
    "Link": {"type":"object","properties":{"link_id":{"$ref":"urn:mce4d:contracts:1#/$defs/ID"},"source":{"$ref":"#/$defs/Endpoint"},"target":{"$ref":"#/$defs/Endpoint"},"kind":{"$ref":"urn:mce4d:contracts:1#/$defs/ID"},"evidence":{"$ref":"urn:mce4d:contracts:1#/$defs/EvidenceRef"},"resolution_status":{"enum":["exact_in_supported_scope","candidate","unresolved"]}},"required":["link_id","source","target","kind","evidence","resolution_status"],"additionalProperties":false},
    "Batch": {"type":"object","properties":{"schema_version":{"const":1},"entities":{"type":"array","items":{"$ref":"#/$defs/Entity"},"minItems":0,"maxItems":512},"fields":{"type":"array","items":{"$ref":"#/$defs/Field"},"minItems":0,"maxItems":2048},"links":{"type":"array","items":{"$ref":"#/$defs/Link"},"minItems":0,"maxItems":4096}},"required":["schema_version","entities","fields","links"],"additionalProperties":false}
  }
}
