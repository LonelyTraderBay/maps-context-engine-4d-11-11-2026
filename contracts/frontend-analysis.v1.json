{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mce4d:frontend-analysis:1",
  "$ref": "#/$defs/Result",
  "$defs": {
    "LiteralPath": {"type":"string","maxLength":1000,"pattern":"^/(?:[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*)?$"},
    "Site": {"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":4096},"start_byte":{"type":"integer","minimum":0,"maximum":9007199254740991},"end_byte":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["path","start_byte","end_byte"],"additionalProperties":false},
    "Route": {"type":"object","properties":{"config":{"type":"string","minLength":1,"maxLength":4096},"path":{"$ref":"#/$defs/LiteralPath"},"site":{"$ref":"#/$defs/Site"},"component":{"$ref":"#/$defs/Site"}},"required":["config","path","site","component"],"additionalProperties":false},
    "Call": {"type":"object","properties":{"config":{"type":"string","minLength":1,"maxLength":4096},"path":{"$ref":"#/$defs/LiteralPath"},"site":{"$ref":"#/$defs/Site"},"method":{"enum":["GET","POST","PUT","PATCH","DELETE","HEAD","OPTIONS"]}},"required":["config","path","site","method"],"additionalProperties":false},
    "Result": {"type":"object","properties":{"frontend_protocol":{"const":1},"job_id":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},"input_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"routes":{"type":"array","maxItems":4096,"items":{"$ref":"#/$defs/Route"}},"clients":{"type":"array","maxItems":4096,"items":{"$ref":"#/$defs/Call"}},"gaps":{"type":"array","maxItems":64,"items":{"enum":["TS_CAPTURE_INCOMPLETE","TS_CONFIG_CYCLE","TS_CONFIG_INVALID","TS_CONFIG_OUTSIDE_CAPTURE","TS_CONFIG_PLUGINS_UNSUPPORTED","TS_SYNTAX_ONLY","FRONTEND_ROUTE_PROPERTIES_UNRESOLVED","FRONTEND_ROUTE_UNRESOLVED","FRONTEND_CLIENT_UNRESOLVED"]}}},"required":["frontend_protocol","job_id","input_digest","routes","clients","gaps"],"additionalProperties":false}
  }
}
