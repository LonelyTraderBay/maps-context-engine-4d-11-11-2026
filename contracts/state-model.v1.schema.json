{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mce4d:state-model:1",
  "type": "object",
  "properties": {
    "format": {
      "const": "mce4d-state-model-v1"
    },
    "machine_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "initial": {
      "$ref": "#/$defs/id"
    },
    "states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/state"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "guards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guard"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      },
      "minItems": 0,
      "maxItems": 512
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invariant"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/term"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      },
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "format",
    "machine_id",
    "version",
    "initial",
    "states",
    "events",
    "guards",
    "actions",
    "transitions",
    "invariants",
    "vocabulary",
    "obligations"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "state": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "atomic",
            "compound",
            "final"
          ]
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "initial": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "exit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "parent",
        "initial",
        "entry",
        "exit"
      ],
      "additionalProperties": false
    },
    "guard": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "id",
        "expression"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "effect": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "effect"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "event": {
          "$ref": "#/$defs/id"
        },
        "guard": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "handling": {
          "enum": [
            "normal",
            "retry",
            "cancel",
            "timeout",
            "compensation"
          ]
        },
        "timeout_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "max_attempts": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "event",
        "guard",
        "actions",
        "handling",
        "timeout_ms",
        "max_attempts"
      ],
      "additionalProperties": false
    },
    "invariant": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "$ref": "#/$defs/id"
        },
        "guard": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "state",
        "guard"
      ],
      "additionalProperties": false
    },
    "term": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "id",
        "meaning"
      ],
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "transition": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "idempotency",
            "compensation",
            "reconciliation",
            "atomicity",
            "retry",
            "timeout",
            "authorization",
            "audit"
          ]
        },
        "status": {
          "enum": [
            "evidence",
            "unknown",
            "not_applicable_with_reason"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "transition",
        "kind",
        "status",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
