{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mce4d:architecture:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "mce4d-architecture-v1"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 1,
      "maxItems": 128
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "exemptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exemption"
      },
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "format",
    "components",
    "rules",
    "exemptions"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "service_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "worktree_id": {
          "type": "string",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "profile_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "module_id": {
          "$ref": "#/$defs/id"
        },
        "intended": {
          "enum": [
            "implemented",
            "planned"
          ]
        }
      },
      "required": [
        "id",
        "service_id",
        "worktree_id",
        "profile_id",
        "module_id",
        "intended"
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "allow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "transitive": {
          "type": "boolean"
        },
        "relation": {
          "enum": [
            "imports",
            "depends_on"
          ]
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "id",
        "from",
        "allow",
        "transitive",
        "relation",
        "severity",
        "rationale"
      ]
    },
    "exemption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "rule_id": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "expires_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 35
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "id",
        "rule_id",
        "target",
        "expires_at",
        "rationale"
      ]
    }
  }
}
