            "metadata"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "tokenizer"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "revision": {
                  "$ref": "#/$defs/identifier"
                },
                "digest": {
                  "$ref": "#/$defs/digest"
                },
                "provider": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "metadata"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "chunker"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "revision": {
                  "$ref": "#/$defs/identifier"
                },
                "chunk_size": {
                  "$ref": "#/$defs/positive"
                },
                "overlap": {
                  "$ref": "#/$defs/nonnegative"
                },
                "unit": {
                  "$ref": "#/$defs/chunk_unit"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "metadata"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "embedding"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "revision": {
                  "$ref": "#/$defs/identifier"
                },
                "dimension": {
                  "$ref": "#/$defs/dimension"
                },
                "metric": {
                  "$ref": "#/$defs/metric"
                },
                "provider": {
                  "$ref": "#/$defs/identifier"
                },
                "artifact_id": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "metadata"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "vector_index"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "revision": {
                  "$ref": "#/$defs/identifier"
                },
                "dimension": {
                  "$ref": "#/$defs/dimension"
                },
                "metric": {
                  "$ref": "#/$defs/metric"
                },
                "schema_digest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "metadata"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "retrieval"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "revision": {
                  "$ref": "#/$defs/identifier"
                },
                "input_schema_digest": {
                  "$ref": "#/$defs/digest"
                },
                "output_schema_digest": {
                  "$ref": "#/$defs/digest"
                },
                "timeout_ms": {
                  "$ref": "#/$defs/positive"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "metadata"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "reranker"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "revision": {
                  "$ref": "#/$defs/identifier"
                },
                "provider": {
                  "$ref": "#/$defs/identifier"
                },
                "digest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
