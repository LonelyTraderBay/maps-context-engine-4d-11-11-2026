          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "output_schema"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "schema_digest": {
                  "$ref": "#/$defs/digest"
                },
                "revision": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "metadata"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
